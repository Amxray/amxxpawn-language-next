{
    "name": "amxx-pawn-language-editor",
    "displayName": "%extension.displayName%",
    "description": "%extension.description%",
    "version": "1.5.5",
    "publisher": "iceeedR",
    "license": "GPL-3.0",
    "icon": "images/extension-logo.png",
    "galleryBanner": {
        "theme": "dark",
        "color": "#251654"
    },
    "author": {
        "name": "KliPPy",
        "url": "https://forums.alliedmods.net/member.php?u=228599"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/NiceFeatures/amxxpawn-language"
    },
    "bugs": {
        "url": "https://github.com/NiceFeatures/amxxpawn-language/issues"
    },
    "keywords": [
        "amxx",
        "amxmodx",
        "pawn",
        "alliedmodders"
    ],
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Programming Languages",
        "Linters",
        "Snippets"
    ],
    "activationEvents": [],
    "main": "./dist/client.js",
    "contributes": {
        "configurationDefaults": {
            "[amxxpawn]": {
                "editor.semanticHighlighting.enabled": true
            }
        },
        "languages": [
            {
                "id": "amxxpawn",
                "aliases": [
                    "AMXXPawn",
                    "amxxpawn",
                    "AMXX Pawn"
                ],
                "extensions": [
                    ".sma",
                    ".inc"
                ],
                "firstLine": "#include\\s+[<\"]?\\s*amxmodx\\s*[>\"]?",
                "configuration": "./language-configuration.json"
            },
            {
                "id": "pawndoc",
                "aliases": [
                    "PAWNDoc",
                    "PAWN-Doc",
                    "PAWN Doc"
                ]
            }
        ],
        "grammars": [
            {
                "language": "amxxpawn",
                "scopeName": "source.amxxpawn",
                "path": "./syntaxes/amxxpawn.tmLanguage"
            },
            {
                "language": "pawndoc",
                "scopeName": "text.pawndoc",
                "path": "./syntaxes/pawndoc.json",
                "injectTo": [
                    "amxxpawn"
                ]
            }
        ],
        "snippets": [
            {
                "language": "amxxpawn",
                "path": "./snippets/amxxpawn.json"
            }
        ],
        "configuration": {
            "id": "amxxpawn",
            "type": "object",
            "title": "%configuration.title%",
            "properties": {
                "amxxpawn.reparseInterval": {
                    "type": "number",
                    "default": 1500,
                    "description": "%configuration.reparseInterval.description%"
                },
                "amxxpawn.webApiLinks": {
                    "type": "boolean",
                    "default": false,
                    "description": "%configuration.webApiLinks.description%"
                },
                "amxxpawn.includePaths": {
                    "type": "array",
                    "default": [],
                    "description": "%configuration.includePaths.description%"
                },
                "amxxpawn.inlineErrors": {
                    "type": "boolean",
                    "default": false,
                    "description": "%configuration.inlineErrors.description%"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run esbuild",
        "compile": "tsc -noEmit -p ./",
        "esbuild": "node esbuild.js --production",
        "watch": "node esbuild.js --watch"
    },
    "devDependencies": {
        "@types/node": "^18.0.0",
        "@types/vscode": "^1.75.0",
        "@vscode/test-electron": "^2.3.0",
        "esbuild": "^0.27.4",
        "typescript": "^5.0.0"
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.1",
        "vscode-languageserver": "^9.0.1",
        "vscode-languageserver-textdocument": "^1.0.8",
        "vscode-uri": "^3.0.7"
    }
}
